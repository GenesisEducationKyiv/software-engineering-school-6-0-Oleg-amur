POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=release_notifier

SERVER_HOST=0.0.0.0
SERVER_PORT=8080
GRPC_PORT=50051

DATABASE_URL=postgres://postgres:postgres@postgresql:5432/release_notifier?sslmode=disable

EVENT_BUS_URL=amqp://guest:guest@rabbitmq:5672/
NOTIFICATION_EXCHANGE=notifications
NOTIFICATION_QUEUE=notification-worker
NOTIFICATION_DEAD_LETTER_QUEUE=notification-worker.dlq

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TIMEOUT=10s
FROM_EMAIL=no-reply@test.com
BASE_URL=http://localhost:8080

SCAN_INTERVAL=1m

GITHUB_TIMEOUT=10s
GITHUB_URL=https://api.github.com
GITHUB_TOKEN=your_github_token_here
